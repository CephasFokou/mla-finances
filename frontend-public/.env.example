# Site public de don — copier en .env.local (ignoré par git). Vite ne lit que les variables VITE_*.
# URL de base de l'API backend (sans slash final).
VITE_API_BASE_URL=http://localhost:8080/api/v1
# Numéro de paiement du MLA affiché après l'enregistrement d'un don en mode manuel (facultatif).
VITE_MLA_PAYMENT_NUMBER=
