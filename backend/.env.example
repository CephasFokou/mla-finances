# Variables locales du backend MLA Finance — copier en backend/.env (ignoré par git) et compléter.
# Lu automatiquement par Spring Boot au démarrage (spring.config.import dans application.yml) ; les
# vraies variables d'environnement, si elles existent, gardent la priorité. Format : CLE=valeur, sans
# guillemets ni "export". Les profils Spring (dev, local, prod) NE peuvent PAS être fixés ici :
# ./scripts/dev-backend.sh lance le backend avec dev,local par défaut.

# --- CORS : origines des deux frontends (ports fixés par strictPort dans chaque vite.config.ts) ---
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_FRONTEND_ORIGIN=http://localhost:5180
# Lien « Contribuer maintenant » des relances (facultatif, défaut : PUBLIC_FRONTEND_ORIGIN)
# PUBLIC_SITE_URL=http://localhost:5180
# URL du back-office, utilisée dans les liens des emails d'invitation / réinitialisation.
FRONTEND_BASE_URL=http://localhost:5173

# --- JWT (RG-18) : secret de signature HMAC256, >= 32 caractères aléatoires (openssl rand -base64 64) ---
JWT_SECRET=remplacer-par-une-valeur-aleatoire-de-64-caracteres-minimum

# --- Email transactionnel (Resend, même compte que PÉNIEL). Vide = aucun envoi, juste un avertissement ---
RESEND_API_KEY=
EMAIL_FROM=MLA Finance <no-reply@mla-finance.dev>

# --- Base PostgreSQL locale (profil local). Par défaut : localhost:5432/mla_finance, utilisateur système ---
DATABASE_URL=jdbc:postgresql://localhost:5432/mla_finance
DATABASE_USERNAME=
DATABASE_PASSWORD=

# --- PawaPay (sandbox). Jeton : dashboard.sandbox.pawapay.io → Developers → API tokens ---
PAWAPAY_ENABLED=false
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN=
# Secret du chemin de callback : l'URL à déclarer dans le dashboard PawaPay est
# <URL publique de l'API>/api/v1/webhooks/pawapay/<PAWAPAY_CALLBACK_SECRET>
# (openssl rand -hex 16). En local, PawaPay ne peut pas joindre le poste : le job de réconciliation
# interroge PawaPay toutes les 15 s à la place.
PAWAPAY_CALLBACK_SECRET=

# --- Limitation de débit : X-Forwarded-For n'est cru que derrière un proxy maîtrisé (true sur Railway) ---
RATE_LIMIT_TRUST_PROXY=false

# --- Logs (DEBUG par défaut en dev) ---
# LOG_LEVEL_APP=INFO

# WhatsApp des relances (Kapso). Sans KAPSO_ENABLED=true : relances par email seulement.
KAPSO_ENABLED=false
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=
