<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.26.xsd">

    <!-- Messages WhatsApp envoyés par MLA Finance en réponse à un membre (liste de dates, confirmations…). Le numéro
         est partagé avec le suivi des tâches MLA : un message entrant n'est traité que s'il répond (context.id) à un
         wamid envoyé par MLA Finance — relance (reminder_deliveries) ou réponse (cette table) — ou porte un bouton
         « mlaf: ». -->
    <changeSet id="0021-01-reminder-whatsapp-replies" author="mla-finance">
        <createTable tableName="reminder_whatsapp_replies">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_reminder_whatsapp_replies_case" references="reminder_cases(id)"/>
            </column>
            <column name="provider_message_id" type="VARCHAR(120)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_reminder_whatsapp_replies_msg"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
