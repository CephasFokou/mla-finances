<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.26.xsd">

    <changeSet id="0002-01-seed-roles" author="mla-finance">
        <insert tableName="roles">
            <column name="name" value="SUPER_ADMIN"/>
            <column name="description" value="Accès complet à l'administration et à la configuration"/>
        </insert>
        <insert tableName="roles">
            <column name="name" value="TRESORIER"/>
            <column name="description" value="Gestion des contributions, projets et retraits"/>
        </insert>
        <insert tableName="roles">
            <column name="name" value="OPERATEUR"/>
            <column name="description" value="Saisie des contributions au quotidien"/>
        </insert>
        <insert tableName="roles">
            <column name="name" value="AUDITEUR"/>
            <column name="description" value="Lecture seule : rapports et journaux d'audit"/>
        </insert>
    </changeSet>

    <changeSet id="0002-02-seed-payment-channels" author="mla-finance">
        <insert tableName="payment_channels">
            <column name="code" value="ORANGE_MONEY"/>
            <column name="label" value="Orange Money"/>
            <column name="sort_order" valueNumeric="1"/>
        </insert>
        <insert tableName="payment_channels">
            <column name="code" value="MTN_MOMO"/>
            <column name="label" value="MTN Mobile Money"/>
            <column name="sort_order" valueNumeric="2"/>
        </insert>
        <insert tableName="payment_channels">
            <column name="code" value="CARD"/>
            <column name="label" value="Carte bancaire (Visa/Mastercard)"/>
            <column name="sort_order" valueNumeric="3"/>
        </insert>
        <insert tableName="payment_channels">
            <column name="code" value="CASH"/>
            <column name="label" value="Espèces"/>
            <column name="sort_order" valueNumeric="4"/>
        </insert>
        <insert tableName="payment_channels">
            <column name="code" value="BANK_TRANSFER"/>
            <column name="label" value="Virement bancaire"/>
            <column name="sort_order" valueNumeric="5"/>
        </insert>
    </changeSet>

</databaseChangeLog>
