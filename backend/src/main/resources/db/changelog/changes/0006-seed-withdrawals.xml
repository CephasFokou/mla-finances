<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.26.xsd">

    <!--
        Exemples de demandes de retrait couvrant les quatre statuts du workflow, sur les projets
        et catégories déjà seedés par 0004-seed-demo-data.xml (project_id=1 "Toiture du Temple
        Central", project_id=4 "Rénovation Salle Enfants", category_id=1 "Cotisation MLA").
    -->

    <changeSet id="0006-01-seed-withdrawals" author="mla-finance">
        <insert tableName="withdrawals">
            <column name="project_id" valueNumeric="1"/>
            <column name="amount" valueNumeric="250000"/>
            <column name="reason" value="Achat de tôles et matériaux de couverture"/>
            <column name="status" value="PROCESSED"/>
            <column name="requested_at" valueDate="2026-08-05T09:00:00"/>
            <column name="decided_at" valueDate="2026-08-06T14:30:00"/>
            <column name="processed_at" valueDate="2026-08-08T11:00:00"/>
        </insert>
        <insert tableName="withdrawals">
            <column name="project_id" valueNumeric="1"/>
            <column name="amount" valueNumeric="80000"/>
            <column name="reason" value="Main d'œuvre — pose de la toiture (acompte)"/>
            <column name="status" value="APPROVED"/>
            <column name="requested_at" valueDate="2026-09-10T08:15:00"/>
            <column name="decided_at" valueDate="2026-09-11T16:00:00"/>
        </insert>
        <insert tableName="withdrawals">
            <column name="project_id" valueNumeric="4"/>
            <column name="amount" valueNumeric="45000"/>
            <column name="reason" value="Peinture et petit mobilier pour la salle des enfants"/>
            <column name="status" value="PENDING"/>
            <column name="requested_at" valueDate="2026-09-18T10:00:00"/>
        </insert>
        <insert tableName="withdrawals">
            <column name="project_id" valueNumeric="4"/>
            <column name="amount" valueNumeric="15000"/>
            <column name="reason" value="Devis complémentaire pour étagères sur mesure"/>
            <column name="status" value="REJECTED"/>
            <column name="requested_at" valueDate="2026-09-12T09:30:00"/>
            <column name="decided_at" valueDate="2026-09-13T10:00:00"/>
            <column name="rejection_reason" value="Montant hors budget prévisionnel — à représenter avec un devis revu à la baisse"/>
        </insert>
        <insert tableName="withdrawals">
            <column name="category_id" valueNumeric="1"/>
            <column name="amount" valueNumeric="20000"/>
            <column name="reason" value="Fournitures de bureau pour le secrétariat"/>
            <column name="status" value="PENDING"/>
            <column name="requested_at" valueDate="2026-09-20T14:00:00"/>
        </insert>
    </changeSet>

</databaseChangeLog>
