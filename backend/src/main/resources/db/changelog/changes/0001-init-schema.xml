<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.26.xsd">

    <changeSet id="0001-01-create-roles" author="mla-finance">
        <createTable tableName="roles">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(40)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0001-02-create-role-permissions" author="mla-finance">
        <createTable tableName="role_permissions">
            <column name="role_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="permission_code" type="VARCHAR(60)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="role_permissions" columnNames="role_id, permission_code" constraintName="pk_role_permissions"/>
        <addForeignKeyConstraint baseTableName="role_permissions" baseColumnNames="role_id"
            constraintName="fk_role_permissions_role" referencedTableName="roles" referencedColumnNames="id" onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="0001-03-create-users" author="mla-finance">
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(180)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="full_name" type="VARCHAR(180)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(30)" defaultValue="PENDING_INVITATION">
                <constraints nullable="false"/>
            </column>
            <column name="invitation_token" type="VARCHAR(120)"/>
            <column name="invitation_expires_at" type="TIMESTAMP"/>
            <column name="last_login_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0001-04-create-user-roles" author="mla-finance">
        <createTable tableName="user_roles">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="role_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="user_roles" columnNames="user_id, role_id" constraintName="pk_user_roles"/>
        <addForeignKeyConstraint baseTableName="user_roles" baseColumnNames="user_id"
            constraintName="fk_user_roles_user" referencedTableName="users" referencedColumnNames="id" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="user_roles" baseColumnNames="role_id"
            constraintName="fk_user_roles_role" referencedTableName="roles" referencedColumnNames="id" onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="0001-05-create-payment-channels" author="mla-finance">
        <createTable tableName="payment_channels">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(40)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="label" type="VARCHAR(80)">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="sort_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0001-06-create-donation-categories" author="mla-finance">
        <createTable tableName="donation_categories">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(120)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0001-07-create-projects" author="mla-finance">
        <createTable tableName="projects">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(180)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(1000)"/>
            <column name="status" type="VARCHAR(30)" defaultValue="DRAFT">
                <constraints nullable="false"/>
            </column>
            <column name="opening_balance" type="NUMERIC(14,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="target_amount" type="NUMERIC(14,2)"/>
            <column name="recurring_series_id" type="VARCHAR(60)"/>
            <column name="start_date" type="DATE"/>
            <column name="end_date" type="DATE"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0001-08-create-donors" author="mla-finance">
        <createTable tableName="donors">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="full_name" type="VARCHAR(180)"/>
            <column name="email" type="VARCHAR(180)"/>
            <column name="phone" type="VARCHAR(40)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0001-09-create-contributions" author="mla-finance">
        <createTable tableName="contributions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="BIGINT"/>
            <column name="category_id" type="BIGINT"/>
            <column name="donor_id" type="BIGINT"/>
            <column name="payment_channel_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_by_id" type="BIGINT"/>
            <column name="amount" type="NUMERIC(14,2)">
                <constraints nullable="false"/>
            </column>
            <column name="period_month" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="movement_type" type="VARCHAR(20)" defaultValue="STANDARD">
                <constraints nullable="false"/>
            </column>
            <column name="anonymous" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="reference" type="VARCHAR(60)">
                <constraints unique="true"/>
            </column>
            <column name="notes" type="VARCHAR(500)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="contributions" baseColumnNames="project_id"
            constraintName="fk_contributions_project" referencedTableName="projects" referencedColumnNames="id" onDelete="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="contributions" baseColumnNames="category_id"
            constraintName="fk_contributions_category" referencedTableName="donation_categories" referencedColumnNames="id" onDelete="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="contributions" baseColumnNames="donor_id"
            constraintName="fk_contributions_donor" referencedTableName="donors" referencedColumnNames="id" onDelete="SET NULL"/>
        <addForeignKeyConstraint baseTableName="contributions" baseColumnNames="payment_channel_id"
            constraintName="fk_contributions_channel" referencedTableName="payment_channels" referencedColumnNames="id" onDelete="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="contributions" baseColumnNames="created_by_id"
            constraintName="fk_contributions_created_by" referencedTableName="users" referencedColumnNames="id" onDelete="SET NULL"/>
    </changeSet>

    <changeSet id="0001-10-contributions-project-xor-category" author="mla-finance">
        <sql>
            ALTER TABLE contributions
                ADD CONSTRAINT chk_contribution_project_xor_category
                CHECK (
                    (project_id IS NOT NULL AND category_id IS NULL)
                    OR (project_id IS NULL AND category_id IS NOT NULL)
                );
        </sql>
    </changeSet>

</databaseChangeLog>
