<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.26.xsd">

    <!-- Paiement en ligne via PawaPay (RG-20 idempotence) : identifiant de dépôt unique généré par
         nos soins et réutilisé tel quel vers PawaPay (un même depositId ne peut jamais déclencher
         deux paiements), jeton de suivi non devinable pour le polling public, numéro payeur,
         statut rapporté par PawaPay, échec, et planification de la réconciliation. -->
    <changeSet id="0013-01-payment-tx-online-columns" author="mla-finance">
        <addColumn tableName="payment_transactions">
            <column name="deposit_id" type="VARCHAR(36)"/>
            <column name="tracking_token" type="VARCHAR(36)"/>
            <column name="payer_phone" type="VARCHAR(20)"/>
            <column name="provider_status" type="VARCHAR(30)"/>
            <column name="failure_code" type="VARCHAR(60)"/>
            <column name="failure_message" type="VARCHAR(500)"/>
            <column name="next_check_at" type="TIMESTAMP"/>
            <column name="check_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="needs_review" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </addColumn>
        <addUniqueConstraint tableName="payment_transactions" columnNames="deposit_id" constraintName="uk_payment_tx_deposit_id"/>
        <addUniqueConstraint tableName="payment_transactions" columnNames="tracking_token" constraintName="uk_payment_tx_tracking_token"/>
        <createIndex tableName="payment_transactions" indexName="ix_payment_tx_status_next_check">
            <column name="status"/>
            <column name="next_check_at"/>
        </createIndex>
        <createIndex tableName="payment_transactions" indexName="ix_payment_tx_payer_phone_created">
            <column name="payer_phone"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
