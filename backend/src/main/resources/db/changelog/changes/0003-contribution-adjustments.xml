<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.26.xsd">

    <changeSet id="0003-01-add-adjusts-contribution-id" author="mla-finance">
        <addColumn tableName="contributions">
            <column name="adjusts_contribution_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="contributions" baseColumnNames="adjusts_contribution_id"
            constraintName="fk_contributions_adjusts" referencedTableName="contributions" referencedColumnNames="id" onDelete="SET NULL"/>
    </changeSet>

    <!-- Filet de sécurité : une contribution ne peut être annulée qu'une seule fois, même en cas de requêtes concurrentes. -->
    <changeSet id="0003-02-unique-adjusts-contribution-id" author="mla-finance">
        <addUniqueConstraint tableName="contributions" columnNames="adjusts_contribution_id"
            constraintName="uq_contributions_adjusts"/>
    </changeSet>

</databaseChangeLog>
