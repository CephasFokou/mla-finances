    <!--
        Données de démonstration pour les listes de référence (catégories de don, projets,
        donateurs) exploitées par le formulaire "Nouvelle contribution" et les écrans de liste.
        0002-seed-reference-data.xml ne couvrait que les rôles et les canaux de paiement ; ces
        trois tables restaient vides, ce qui laissait les menus déroulants du back-office sans
        options. Contenu aligné sur le Cahier des Charges validé et sur la maquette back-office
        "MLA Finance — Maquettes" (catégories/projets déjà utilisés comme exemples validés par
        Cephas), pour rester cohérent avec ce que l'équipe a déjà vu et approuvé.
    -->

    <changeSet id="0004-01-seed-donation-categories" author="mla-finance">
        <insert tableName="donation_categories">
            <column name="name" value="Cotisation MLA"/>
            <column name="description" value="Cotisations mensuelles des membres de la communauté MLA"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="donation_categories">
            <column name="name" value="Semence missionnaire"/>
            <column name="description" value="Dons de soutien aux missions et projets missionnaires"/>
